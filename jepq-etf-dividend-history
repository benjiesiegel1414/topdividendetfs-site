function calculateSummary() {
    const totalDivs = dividends.length;
    const totalAmount = dividends.reduce((sum, d) => sum + d.amount, 0);
    const avg = (totalAmount / totalDivs).toFixed(3);

    document.getElementById('totalDividends').textContent = totalDivs;
    document.getElementById('totalAmount').textContent = '$' + totalAmount.toFixed(2);
    document.getElementById('avgMonthly').textContent = '$' + avg;
    document.getElementById('latestDiv').textContent = '$' + dividends[0].amount.toFixed(4);
}

function renderTable(data) {
    const tbody = document.getElementById('tableBody');
    tbody.innerHTML = '';

    data.forEach(div => {
        const row = document.createElement('tr');
        row.innerHTML = `
            <td>${div.ex}</td>
            <td>${div.record}</td>
            <td>${div.pay}</td>
            <td class="amount">$${div.amount.toFixed(4)}</td>
            <td>${div.notes}</td>
        `;
        tbody.appendChild(row);
    });
}

let currentSortCol = 0;
let currentSortDir = 'desc';

function sortTable(col) {
    if (currentSortCol === col) {
        currentSortDir = currentSortDir === 'asc' ? 'desc' : 'asc';
    } else {
        currentSortCol = col;
        currentSortDir = (col === 3) ? 'desc' : 'asc';
    }

    const sortedData = [...dividends].sort((a, b) => {
        let valA, valB;
        switch(col) {
            case 0: valA = a.ex; valB = b.ex; break;
            case 1: valA = a.record; valB = b.record; break;
            case 2: valA = a.pay; valB = b.pay; break;
            case 3: valA = a.amount; valB = b.amount; break;
            case 4: valA = a.notes; valB = b.notes; break;
        }
        if (col === 3) {
            return currentSortDir === 'asc' ? valA - valB : valB - valA;
        }
        return currentSortDir === 'asc' 
            ? String(valA).localeCompare(String(valB))
            : String(valB).localeCompare(String(valA));
    });

    renderTable(sortedData);
}

function applyFilters() {
    const searchTerm = document.getElementById('searchInput').value.toLowerCase().trim();
    const selectedYear = document.getElementById('yearFilter').value;

    const filtered = dividends.filter(div => {
        const matchesSearch = !searchTerm || 
            div.ex.includes(searchTerm) || 
            div.notes.toLowerCase().includes(searchTerm);
        const matchesYear = !selectedYear || div.ex.startsWith(selectedYear);
        return matchesSearch && matchesYear;
    });

    renderTable(filtered);
}

function populateYearFilter() {
    const years = new Set(dividends.map(d => d.ex.substring(0,4)));
    const select = document.getElementById('yearFilter');
    Array.from(years).sort().reverse().forEach(year => {
        const option = document.createElement('option');
        option.value = year;
        option.textContent = year;
        select.appendChild(option);
    });
}

function exportToCSV() {
    let csvContent = "Ex Div Date,Record Date,Pay Date,Amount,Notes\n";
    dividends.forEach(d => {
        csvContent += `"${d.ex}","${d.record}","${d.pay}",${d.amount},"${d.notes}"\n`;
    });
    const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = 'JEPQ_Dividend_History.csv';
    link.click();
}

